{
  "name": "left-justify",
  "version": "1.0.0",
  "description": "Left-justify strings and text blocks — pad right to a fixed width",
  "keywords": ["left-justify", "pad", "string", "text", "align", "format"],
  "author": "Kristoffer Carlson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcarlson/left-justify.git"
  },
  "homepage": "https://github.com/kcarlson/left-justify#readme",
  "bugs": {
    "url": "https://github.com/kcarlson/left-justify/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
